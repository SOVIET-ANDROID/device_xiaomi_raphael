      <item>47.6760716</item>     <!--  33 - 55  -->
      <item>55.73002427</item>    <!--  55 - 90  -->
      <item>66.24126116</item>    <!--  90 - 148  -->
      <item>79.67614115</item>    <!--  148 - 245  -->
      <item>98.04727274</item>    <!--  245 - 403  -->
      <item>125.1221991</item>    <!--  403 - 665  -->
      <item>161.6875093</item>    <!--  665 - 1097  -->

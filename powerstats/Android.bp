// PowerStats AIDL V2 HAL for Xiaomi Raphael (SM8150 / Adreno 640).
// Self-contained: no dependency on hardware/google/pixel/powerstats.

cc_binary {
    name: "android.hardware.power.stats-service.raphael",
    relative_install_path: "hw",
    init_rc: ["android.hardware.power.stats-service.raphael.rc"],
    vintf_fragments: ["android.hardware.power.stats-service.raphael.xml"],
    vendor: true,

    srcs: [
        "service.cpp",
        "PowerStats.cpp",
        "GenericStateResidencyDataProvider.cpp",
        "GpuStateResidencyDataProvider.cpp",
        "DisplayStateResidencyDataProvider.cpp",
    ],

    shared_libs: [
        "libbase",          // android-base logging, ReadFileToString, boot_clock
        "libbinder_ndk",    // ABinderProcess_*, AServiceManager_addService
        "libcutils",
        "liblog",
        "libutils",         // android::Looper used by DisplayStateResidencyDataProvider
        "android.hardware.power.stats-V2-ndk",  // AIDL V2 generated interface
    ],

    cflags: [
        "-Wall",
        "-Werror",
        // Silence unused-parameter warnings in AIDL-generated stubs.
        "-Wno-unused-parameter",
    ],
}

# Audio
audio.offload.buffer.size.kb=32
audio.offload.gapless.enabled=true
persist.audio.fluence.speaker=true
persist.audio.fluence.voicecall=true
persist.audio.fluence.voicerec=false

# Camera
persist.camera.gyro.disable=0

# CNE
persist.vendor.cne.feature=1

# Display
persist.demo.hdmirotationlock=false

# Media
av.offload.enable=true
ro.media.recorder-max-base-layer-fps=60
media.stagefright.enable-player=true
media.stagefright.enable-http=true
media.stagefright.enable-aac=true
media.stagefright.enable-qcp=true
media.stagefright.enable-fma2dp=true
media.stagefright.enable-scan=true
media.stagefright.thumbnail.prefer_hw_codecs=true
media.aac_51_output_enabled=true
mmp.enable.3g2=true
persist.mm.enable.prefetch=true
mm.enable.smoothstreaming=true

# Netmgr
persist.data.df.dev_name=rmnet_usb0
persist.data.wda.enable=true
persist.rmnet.data.enable=true

# NFC
ro.nfc.port=I2C

# RIL
persist.radio.dynamic_sar=false
rild.libpath=/vendor/lib64/libril-qc-hal-qmi.so

# Telephony
# Disable handling audio direction changes on IMS calls.
ro.telephony.handle_audio_direction_changes_between_call_state_changes=false
persist.vendor.qti.telephony.vt_cam_interface=2

# Thermal
vendor.thermal.config=thermal_info_config.json

# Time
persist.timed.enable=true

# Printk
persist.vendor.console.silent.config=1

# Model properties
import /system/system_ext.${ro.boot.hwc}.prop
